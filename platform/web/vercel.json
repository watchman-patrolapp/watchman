{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "vite",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/((?!assets/|sounds/|icons/|\\.well-known/|sw\\.js|firebase-messaging-sw\\.js|.*\\..*).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|sounds/|icons/|\\.well-known/|sw\\.js|firebase-messaging-sw\\.js|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
