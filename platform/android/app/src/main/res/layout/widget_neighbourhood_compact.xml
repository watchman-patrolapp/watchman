<?xml version="1.0" encoding="utf-8"?>
<!-- Watchman Neighbourhood, compact: patrol status plus SOS and Quick report. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="@dimen/wm_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wr_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_logo_cd"
            android:src="@drawable/ic_widget_logo" />

        <LinearLayout
            android:id="@+id/wr_patrol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/wr_patrol_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_widget_torch_patroller_off" />

            <TextView
                android:id="@+id/wr_patrol_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_patrol_active"
                android:textColor="@color/wm_green"
                android:textSize="9sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wr_patrol_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_no_patrol"
                android:textColor="@color/wm_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wr_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/wm_cyan_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/wr_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wr_sos"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_sos"
                android:contentDescription="@string/widget_sos_cd"
                android:gravity="center"
                android:text="@string/widget_alert_sos"
                android:textColor="@color/wm_sos_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_report"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_report"
                android:contentDescription="@string/widget_quick_report_cd"
                android:gravity="center"
                android:text="@string/widget_quick_report"
                android:textColor="@color/wm_cyan_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
