<?xml version="1.0" encoding="utf-8"?>
<!-- Watchman Patrol, full size. States are toggled by visibility in PatrolWidgetProvider. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="@dimen/wm_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wp_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/widget_logo_cd"
                android:src="@drawable/ic_widget_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/widget_wordmark"
                    android:textColor="@color/wm_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wp_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/wm_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/wp_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/wm_cyan_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/wp_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wp_dot"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_off" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/wp_status_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_on_patrol"
                        android:textColor="@color/wm_green"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wp_status_off"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_not_on_patrol"
                        android:textColor="@color/wm_text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/wp_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <Chronometer
                            android:id="@+id/wp_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/widget_timer_cd"
                            android:textColor="@color/wm_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/wp_km"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/wm_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/wp_start"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_btn_start"
                    android:contentDescription="@string/widget_start_patrol_cd"
                    android:gravity="center"
                    android:minWidth="112dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/widget_start_patrol"
                    android:textColor="@color/wm_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wp_end"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_btn_end"
                    android:contentDescription="@string/widget_end_patrol_cd"
                    android:gravity="center"
                    android:minWidth="112dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/widget_end_patrol"
                    android:textColor="@color/wm_end_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/wp_online"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/wp_people"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_people_off" />

                    <TextView
                        android:id="@+id/wp_online_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/wm_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wp_online_off"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/widget_no_patrollers"
                        android:textColor="@color/wm_text_secondary"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/wp_avatar1"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_person"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wp_avatar2"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_person"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wp_avatar3"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_person"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wp_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:textColor="@color/wm_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wp_report"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_btn_report"
                    android:contentDescription="@string/widget_quick_report_cd"
                    android:gravity="center"
                    android:minWidth="112dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/widget_quick_report"
                    android:textColor="@color/wm_cyan_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
