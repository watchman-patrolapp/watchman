<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The shell and the Supabase API are HTTPS only. Capacitor serves the
         bundled web app on https://localhost, which is not cleartext. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
